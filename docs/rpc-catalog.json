        "kind": {
          "description": "bd w2b5: comma-separated kind filter (fn, method, class, struct, enum, interface, module, namespace, package, field, property, variable, constant, file)",
          "required": false,
          "type": "string"
        },
        "limit": {
          "default": 50,
          "description": "bd z0kg: absent → SERENA_DEFAULT_MAX_ITEMS env when set",
          "required": false,
          "type": "number"
