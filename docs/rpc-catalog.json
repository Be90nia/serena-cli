      "args": {
        "name": {
          "description": "recipe: fix-bug|add-feature|rename|add-test|refactor-extract|refactor-rename|review-diff|explore",
          "required": true,
          "type": "string"
        },
        "pos": {
          "description": "positional args; fix-bug/rename/refactor-extract = [file, sym], add-feature = [name], add-test/refactor-rename = [sym], explore = [path], review-diff = [txn-id]",
          "required": false,
          "type": "array"
        },
        "new_body": {
          "description": "fix-bug: replacement function body (absent = analyze-only chain)",
          "required": false,
          "type": "string"
